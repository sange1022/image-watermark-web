{
  "name": "image-watermark-web",
  "version": "1.1.0",
  "description": "Offline batch photo cropping, color adjustment, LUT and watermark tool",
  "author": "戌無营造",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "test:color": "node --test src/color.test.ts",
    "test:desktop": "node desktop/smoke.cjs",
    "desktop": "npm run build && electron .",
